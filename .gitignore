# --- Python & uv ---
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments (uv manages .venv automatically, but good to include)
.venv/
venv/
env/

# Packaging, builds, and distributions
build/
dist/
*.egg-info/
.eggs/
wheels/

# Testing, coverage, and linters
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# --- JavaScript / Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# JS builds & frameworks (Next.js, Vite, React, etc.)
.next/
out/
.nuxt/
.svelte-kit/
.vite/
.cache/
.parcel-cache/
.eslintcache
*.tsbuildinfo

# --- Environment & Secrets ---
.env
.env.*
!.env.example

# --- IDEs & OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Local data ---
data/
*.db
*.db-wal
*.db-shm
